# CloudTrain settings for LOCAL development.
# Copy this file to .env (`cp .env.example .env`). Never commit .env.
# Every value below is a FAKE local value. Real cloud secrets live in AWS Secrets Manager.

# ---------- General ----------
ENVIRONMENT=local
LOG_LEVEL=INFO

# ---------- Login (gateway) ----------
# dev  = accept the fixed DEV_AUTH_TOKEN below (local only)
# jwt  = verify real login tokens (Salem adds this behind the same function)
AUTH_MODE=dev
DEV_AUTH_TOKEN=dev-token-local-only
DEV_USER_ID=user-1
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=

# ---------- Gateway ----------
GATEWAY_PORT=5810
GATEWAY_TIMEOUT_SECONDS=10
GATEWAY_UPLOAD_TIMEOUT_SECONDS=300
# CORS: the local portal is always allowed; add the deployed portal URL here
DEPLOYED_PORTAL_URL=

# ---------- Where each service lives (Docker Compose names) ----------
PROJECT_SERVICE_URL=http://project-service:8001
DATASET_SERVICE_URL=http://dataset-service:8002
JOB_SERVICE_URL=http://job-service:8003
SCHEDULER_URL=http://scheduler:8004
TRAINING_WORKER_URL=http://training-worker:8010
MLFLOW_URL=http://mlflow:5000
MODEL_REGISTRY_URL=http://model-registry:8006
INFERENCE_SERVICE_URL=http://inference-service:8007

# ---------- PostgreSQL: one schema and one user per service ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-local-only
POSTGRES_DB=cloudtrain
PROJECTS_DATABASE_URL=postgresql+psycopg://projects:projects-local-only@postgres:5432/cloudtrain
DATASETS_DATABASE_URL=postgresql+psycopg://datasets:datasets-local-only@postgres:5432/cloudtrain
JOBS_DATABASE_URL=postgresql+psycopg://jobs:jobs-local-only@postgres:5432/cloudtrain
SCHEDULER_DATABASE_URL=postgresql+psycopg://scheduler:scheduler-local-only@postgres:5432/cloudtrain
REGISTRY_DATABASE_URL=postgresql+psycopg://registry:registry-local-only@postgres:5432/cloudtrain
MLFLOW_DATABASE_URL=postgresql://mlflow:mlflow-local-only@postgres:5432/cloudtrain

# ---------- Object storage (MinIO locally, S3 in the cloud) ----------
S3_ENDPOINT=http://minio:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minio-local-only
AWS_SECRET_ACCESS_KEY=minio-local-only-secret
DATASETS_BUCKET=datasets
ARTIFACTS_BUCKET=artifacts

# ---------- Queues (LocalStack SQS locally, SQS in the cloud) ----------
SQS_ENDPOINT=http://localstack:4566
TRAINING_JOBS_QUEUE=training-jobs
TRAINING_JOBS_DLQ=training-jobs-dlq
JOB_EVENTS_QUEUE=job-events
# A message that fails this many times moves to the dead-letter queue
SQS_MAX_RECEIVE_COUNT=3
# How long a read message stays hidden from other readers (covers scheduling time)
SQS_VISIBILITY_TIMEOUT_SECONDS=300

# ---------- Worker heartbeat (settings, not contract rules) ----------
# The timeout must stay at least 3 times the interval.
HEARTBEAT_INTERVAL_SECONDS=30
HEARTBEAT_TIMEOUT_SECONDS=120

# ---------- MLflow ----------
MLFLOW_TRACKING_URI=http://mlflow:5000

# ---------- Cost ----------
PRICING_FILE=/contracts/pricing.yaml

# ---------- Portal ----------
# The browser calls the gateway at this address
NEXT_PUBLIC_GATEWAY_URL=http://localhost:5810
