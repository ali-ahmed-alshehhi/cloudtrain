# CloudTrain settings for LOCAL development.
# Copy this file to .env (`cp .env.example .env`). Never commit .env.
# Every value below is a FAKE local value. Real cloud secrets live in AWS Secrets Manager.

# ---------- General ----------
ENVIRONMENT=local
LOG_LEVEL=INFO

# ---------- Login (gateway) ----------
# dev  = accept the fixed DEV_AUTH_TOKEN below (local only)
# jwt  = verify real login tokens (Salem adds this behind the same function)
AUTH_MODE=dev
DEV_AUTH_TOKEN=dev-token-local-only
DEV_USER_ID=user-1
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=

# ---------- Gateway (port 5810 is fixed by the contract) ----------
GATEWAY_TIMEOUT_SECONDS=10
GATEWAY_UPLOAD_TIMEOUT_SECONDS=300
# CORS: the local portal is always allowed; add the deployed portal URL here
DEPLOYED_PORTAL_URL=

# ---------- Where each service lives (Docker Compose names) ----------
PROJECT_SERVICE_URL=http://project-service:8001
DATASET_SERVICE_URL=http://dataset-service:8002
JOB_SERVICE_URL=http://job-service:8003
SCHEDULER_URL=http://scheduler:8004
TRAINING_WORKER_URL=http://training-worker:8010
MLFLOW_URL=http://mlflow:5000
MODEL_REGISTRY_URL=http://model-registry:8006
INFERENCE_SERVICE_URL=http://inference-service:8007

# ---------- PostgreSQL: one schema and one user per service ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-local-only
POSTGRES_DB=cloudtrain
PROJECTS_DATABASE_URL=postgresql+psycopg://projects:projects-local-only@postgres:5432/cloudtrain
DATASETS_DATABASE_URL=postgresql+psycopg://datasets:datasets-local-only@postgres:5432/cloudtrain
JOBS_DATABASE_URL=postgresql+psycopg://jobs:jobs-local-only@postgres:5432/cloudtrain
SCHEDULER_DATABASE_URL=postgresql+psycopg://scheduler:scheduler-local-only@postgres:5432/cloudtrain
REGISTRY_DATABASE_URL=postgresql+psycopg://registry:registry-local-only@postgres:5432/cloudtrain
# MLflow keeps its tables in the schema "mlflow" (search_path tells PostgreSQL which schema to use)
MLFLOW_DATABASE_URL=postgresql://mlflow:mlflow-local-only@postgres:5432/cloudtrain?options=-csearch_path%3Dmlflow

# ---------- AWS access (LocalStack accepts any key locally; the cloud uses IAM roles, no keys) ----------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=localstack-local-only
AWS_SECRET_ACCESS_KEY=localstack-local-only

# ---------- Object storage (LocalStack S3 locally, S3 in the cloud; see docs/decisions/0005) ----------
S3_ENDPOINT=http://localstack:4566
DATASETS_BUCKET=datasets
ARTIFACTS_BUCKET=artifacts

# ---------- Queues (LocalStack SQS locally, SQS in the cloud) ----------
SQS_ENDPOINT=http://localstack:4566
TRAINING_JOBS_QUEUE=training-jobs
TRAINING_JOBS_DLQ=training-jobs-dlq
JOB_EVENTS_QUEUE=job-events
# A message that fails this many times moves to the dead-letter queue
SQS_MAX_RECEIVE_COUNT=3
# How long a read message stays hidden from other readers (covers scheduling time)
SQS_VISIBILITY_TIMEOUT_SECONDS=300

# ---------- Worker heartbeat (settings, not contract rules) ----------
# The timeout must stay at least 3 times the interval.
HEARTBEAT_INTERVAL_SECONDS=30
HEARTBEAT_TIMEOUT_SECONDS=120
# Training Jobs watchdog: how often it looks for silent workers and jobs past their time limit
JOB_SWEEP_INTERVAL_SECONDS=10
# Training Jobs: how often queue messages that could not be sent yet are retried (the outbox)
JOB_OUTBOX_INTERVAL_SECONDS=2
# Training Jobs: long-polling wait on training-jobs-dlq, and how often a job back from it is queued again
JOB_DLQ_WAIT_SECONDS=20
JOB_DLQ_MAX_REQUEUES=3
# Stand-in worker only: how long its pretend training takes
STANDIN_TRAINING_SECONDS=3

# ---------- Monitoring (Hilal + Adel, #109) ----------
# Grafana admin login, local only (viewers need no login and can only look). Never admin/admin.
GRAFANA_ADMIN_PASSWORD=grafana-local-only
# job-events-monitor: SQS long-poll wait, and how recent the last read must be for /health to be 200
JOB_EVENTS_WAIT_SECONDS=20
JOB_EVENTS_HEALTHY_WITHIN_SECONDS=120

# ---------- MLflow ----------
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=cloudtrain

# ---------- Training runtime ----------
HTTP_TIMEOUT_SECONDS=30
DATASET_MAX_BYTES=10737418240
# Shared memory for PyTorch DataLoader workers (Docker Compose byte value).
TRAINING_SHM_SIZE=2147483648

# ---------- Model Registry and Inference (Majed) ----------
# Where MLflow's server keeps artifacts (mlflow/Dockerfile): mlflow-artifacts:/... is read from here
MLFLOW_ARTIFACTS_DESTINATION=s3://artifacts/mlflow
# How long Inference may take to load and health-check a new version before promotion fails
DEPLOY_TIMEOUT_SECONDS=60
REGISTRY_CALL_TIMEOUT_SECONDS=10
# The model POST /predict uses when the request names none
INFERENCE_DEFAULT_MODEL_ID=model-01
# How often Inference asks the registry which version is live (the registry also tells it at once)
INFERENCE_REFRESH_SECONDS=10
INFERENCE_TOP_K=3
INFERENCE_MAX_IMAGE_BYTES=10485760

# ---------- Cost ----------
PRICING_FILE=/contracts/pricing.yaml

# ---------- Portal ----------
# The browser calls the gateway at this address
NEXT_PUBLIC_GATEWAY_URL=http://localhost:5810
