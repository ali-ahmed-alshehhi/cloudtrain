# Practice apply against LocalStack (matches docker-compose + .env.example names).
# Team LocalStack only enables s3+sqs, so networking/ECR stay off here.
#
#   cd infrastructure
#   export AWS_ACCESS_KEY_ID=test AWS_SECRET_ACCESS_KEY=test AWS_DEFAULT_REGION=us-east-1
#   terraform init
#   terraform apply -var-file=environments/dev/localstack.tfvars.example


environment = "dev"
owner       = "hamda-fatma"
aws_region  = "us-east-1"

use_localstack            = true
localstack_endpoint       = "http://localhost:4568"
enable_networking         = false
enable_container_registry = false

# Same names as .env.example / local/localstack/init.sh
datasets_bucket_name  = "datasets"
artifacts_bucket_name = "artifacts"

sqs_visibility_timeout_seconds = 300
sqs_max_receive_count          = 3
