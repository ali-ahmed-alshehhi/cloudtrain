# Build from the repository root so Adel's tests can read the shared contracts.
FROM node:24-alpine
WORKDIR /workspace/portal
COPY contracts /workspace/contracts
COPY portal/app/lib ./app/lib
COPY portal/tests ./tests
COPY portal/test ./test
COPY portal/lib ./lib
RUN node --test "test/**/*.test.mjs" tests/*.test.mjs
