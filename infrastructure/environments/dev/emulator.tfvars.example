# Practice apply against the official AWS Emulator (Student 6).
# Same resource NAMES as .env.example so teammates can integrate.
#
#   cd infrastructure
#   ./scripts/emulator-up.sh
#   source ./scripts/emulator-env.sh
#   terraform init
#   terraform apply -var-file=environments/dev/emulator.tfvars.example

environment = "dev"
owner       = "hamda-fatma"
aws_region  = "us-east-1"

use_emulator      = true
emulator_endpoint = "https://127.0.0.1:9297"

# Start with storage + queues (matches team contracts). Turn these on after
# checking Emulator fidelity for EC2/ECR.
enable_networking         = false
enable_container_registry = false
enable_database           = false


datasets_bucket_name  = "datasets"
artifacts_bucket_name = "artifacts"

sqs_visibility_timeout_seconds = 300
sqs_max_receive_count          = 3
