# Remote-state bootstrap on the AWS Emulator (decision 0011).
#
#   cd infrastructure
#   ./scripts/emulator-up.sh
#   source ./scripts/emulator-env.sh
#   cd bootstrap
#   terraform init
#   terraform apply -var-file=emulator.tfvars.example

owner      = "hamda-fatma"
aws_region = "us-east-1"

use_emulator      = true
emulator_endpoint = "https://127.0.0.1:9297"

# Same name as backends/emulator.s3.backend.hcl.example
state_bucket_name = "cloudtrain-tfstate"
